# NLAMS Backend Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration (PostgreSQL 16 + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nlams_db
DB_USER=nlams_user
DB_PASSWORD=nlams_secure_2024

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_key
JWT_EXPIRES_IN=8h

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=info

# API Integration (Mock for prototype)
DILRMP_API_URL=https://api.gov.in/dilrmp/v1
BHU_ARJAN_API_URL=https://api.gov.in/bhu-arjan/v1
PFMS_API_URL=https://api.gov.in/pfms/v1
